def _normalize_target(target):
    if target == "native":
        return _native_target()

    if target == "windows":
        return "windows-x64-mingw"

    if target == "linux":
        output = subprocess.check_output(["gcc", "-dumpversion"])
        output = output.decode("utf-8", "ignore").strip()
        output = int(output.split(".", 1)[0])

        if output >= 11:
            return "linux-x64-gcc11"
        else:
            return "linux-x64-gcc"

    if target == "dreamcast":
        return "dreamcast-sh4-gcc"

    if target == "psp":
        return "psp-mips-gcc"

    if target == "android":
        # FIXME: All targets?
        return "android-x86_64-clang"

    raise UnsupportedPlatformError(target)


def _native_target():
    def in_wsl() -> bool:
        return 'microsoft-standard' in platform.uname().release

    if platform.system() == 'Linux':
        if platform.machine() == 'x86_64':
            output = subprocess.check_output(["gcc", "-dumpversion"])
            output = int(output.decode("ascii").split(".")[0])
            if output >= 11:
                return 'linux-x64-gcc11'
            else:
                return 'linux-x64-gcc'
    elif platform.system() == 'Darwin':
        return 'darwin-x64-gcc'
    elif in_wsl():
        return 'windows-x64-mingw'

    raise UnsupportedPlatformError(platform.system())


_PLATFORMS = {
    "linux-x64-gcc": Linux,
    "linux-x64-gcc11": Linux,
    "windows-x64-mingw": Windows,
    "dreamcast-sh4-gcc": Dreamcast,
    "psp-mips-gcc": PSP,
    "android-x86_64-clang": Android,
    "evercade-armv7-gcc": Evercade,
    "raspberrypi-armv7-gcc": RaspberryPi,
}


def main():
    args = sys.argv
    if "--" in args:
        cmake_args = args[args.index("--") + 1:]
        sys.argv[:] = args[:args.index("--")]
    else:
        cmake_args = []

    opts = _build_args()

    # Start and update aren't platform specific
    if opts.subcommand == "start":
        return start(opts.project, opts.branch, opts.target, force=opts.force)
    elif opts.subcommand == "update":
        return update(
            opts.branch,
            update_libraries=(not opts.assets_only)
        )
    elif opts.subcommand == "scan":
        if opts.scan_type == "translations":
            scan_translations(opts.source_language)

        return
    elif opts.subcommand == "package":
        opts.release = True

    try:
        this_target = _native_target()
        target = _normalize_target(opts.platform)

        platform = _PLATFORMS[target](
            target,
            is_native=this_target == target,
            cmake_args=cmake_args,
        )

        platform.target = target

        build_type = BuildType.DEBUG
        if opts.release:
            build_type = BuildType.RELEASE
        elif opts.reldebug:
            build_type = BuildType.RELDEBUG

        if opts.subcommand == "build":
            return platform.build(
                build_type=build_type,
                rebuild=opts.rebuild,
                flavour=opts.flavour,
            )
        elif opts.subcommand == "run":
            return platform.run(
                rebuild=opts.rebuild,
                build_type=build_type,
                flavour=opts.flavour,
            )
        elif opts.subcommand == "test":
            return platform.test()
        elif opts.subcommand == "package":
            return platform.package(flavour=opts.flavour)
        elif opts.subcommand == "debug":
            return platform.debug()

    except UnsupportedPlatformError as e:
        print(e.message)
        return 1

    return 0


if __name__ == '__main__':
    sys.exit(main())
