class Dreamcast(Platform):
    required_docker_image = "kazade/dreamcast-sdk"

    def _generate_cmake_args(self, build_type=BuildType.DEBUG):
        args = super()._generate_cmake_args(build_type=build_type)
        args, root = args[:-1], args[-1:]

        toolchain = _find_shipped_path("toolchains/Dreamcast.cmake")
        args += ["-DCMAKE_TOOLCHAIN_FILE=%s" % toolchain]

        return args + root

    def _scramble_binary(self, cwd, binary, dest):
        bin_file = splitext(binary)[0] + ".bin"
        commands = [
            "source /etc/bash.bashrc; sh-elf-objcopy -R .stack -O binary -S -g {} {}".format(binary, bin_file),
            "source /etc/bash.bashrc; /opt/toolchains/dc/kos/utils/scramble/scramble {} {}".format(bin_file, dest),
            "rm {}".format(bin_file)  # Remove intermediate file
        ]

        print("Scrambling binary".ljust(_STR_LENGTH), end='')
        for command in commands:
            self._run_command(command.split(), cwd=cwd)
        print("[ OK ]")

    def _generate_ip_bin(self, cwd, template, text, dest):
        command = "IP_TEMPLATE_FILE={template} /opt/toolchains/dc/kos/utils/makeip/makeip {text} {dest}".format(
            template=template, dest=dest, text=text
        ).split()

        print("Generating IP.BIN".ljust(_STR_LENGTH), end='')

        self._run_command(command, cwd=cwd)

        print("[ OK ]")

        return dest

    def package(self, flavour=""):
        # Perform a release rebuild
        self.build(build_type=BuildType.RELEASE, rebuild=True, flavour=flavour)

        build_dir = self._calc_build_dir(build_type=BuildType.RELEASE)
        package_dir = os.path.join(_project_path("packages"), self.target)
        package_tmp_dir = join(_project_path("packages"), self.target + "-tmp")

        for folder in (package_dir, package_tmp_dir):
            if os.path.exists(folder):
                shutil.rmtree(folder)

            os.makedirs(folder)

        config = _project_path("simulant.json")

        with open(config) as f:
            data = json.loads(f.read())
            executable = data["executable"]

        source_assets_dir = _project_path("assets")
        target_assets_dir = join(package_tmp_dir, "assets")
        os.makedirs(target_assets_dir, exist_ok=True)

        source_asset_list = self._generate_asset_list(data, flavour)
        for asset in source_asset_list:
            if not os.path.isfile(asset):
                continue

            relative = asset.replace(source_assets_dir, "").lstrip("/")
            final_path = join(target_assets_dir, relative)
            os.makedirs(dirname(final_path), exist_ok=True)
            shutil.copy(asset, final_path)

        binary = "%s.elf" % executable
        binary = join(build_dir, binary)

        command = [
            "mkdcdisc",
            "-d", target_assets_dir,
            "-e", binary,
            "-n", data["name"].replace(" ", "\\ "),
            "-a", data["author"].replace(" ", "\\ "),
            "-o", str(os.path.join(package_dir, "%s.cdi" % data["name"])).replace(" ", "\\ "),
        ]

        if os.path.exists("cdda"):
            abs = os.path.abspath("cdda")
            for f in sorted(os.listdir(abs)):
                if f.endswith(".wav"):
                    cdaudio = data.get("flavours", {}).get(flavour, {}).get("cdaudio", None)
                    if cdaudio is not None and f not in cdaudio:
                        continue

                    audio_file = os.path.join(abs, f)
                    command.extend([
                        "-c", audio_file
                    ])

        print("Generating CDI".ljust(_STR_LENGTH), end='')
        self._run_command(command, cwd=package_dir)
        print("[ OK ]")

        # return os.path.join(package_dir, "%s.cdi" % data["executable"])
        return 0

    def run(self, rebuild=True, build_type=BuildType.RELEASE, flavour=""):
        supported_emulators = ("lxdream-nitro", "redream", "lxdream")
        commands = {
            "lxdream-nitro": "lxdream-nitro -b",
            "lxdream": "lxdream -b",
            "redream": "redream"
        }

        package_dir = os.path.join(_project_path("packages"), self.target)

        with open("simulant.json", "r") as fin:
            data = json.loads(fin.read())

        cdi_path = os.path.join(package_dir, data["executable"] + ".cdi")

        if not os.path.exists(cdi_path) or rebuild:
            # We need to package things up to run the dreamcast build
            ret_code = self.package(flavour=flavour)
            assert(ret_code == 0)

        for emu in supported_emulators:
            try:
                self._run_command(
                    ("%s --help" % emu).split(),
                    cwd=os.path.dirname(cdi_path),
                    use_docker_image=False
                )
                break
            except (subprocess.CalledProcessError, FileNotFoundError,):
                print("Unable to find %s" % emu)
                continue
        else:
            print(
                "Unable to find a supported emulator. Install one of %s" % supported_emulators
            )
            sys.exit(1)

        self._run_command(
            ("%s %s" % (commands[emu], cdi_path)).split(),
            cwd=os.path.dirname(cdi_path),
            use_docker_image=False
        )


class Android(Platform):
    required_docker_image = "kazade/android-sdk"
    gradle_binary = "gradlew"

    def _calc_gradle_dir(self):
        return os.path.abspath("gradle")

    def build(self, build_type=BuildType.DEBUG, rebuild=False, print_output=True, flavour="", testing=False):
        gradle_cache_dir = join(_find_project_root(), "cache")

        if not os.path.exists(gradle_cache_dir):
            os.makedirs(gradle_cache_dir)

        volumes = {
            gradle_cache_dir: {
                "bind": "/root/.gradle",
                "mode": "Z"
            }
        }

        self._prepare(build_type=build_type, flavour=flavour, volumes=volumes)

        if rebuild:
            build_dir = self._calc_build_dir(build_type=build_type)
            if os.path.exists(build_dir):
                shutil.rmtree(build_dir)

        # Default behaviour is too use cmake to build
        build_dir = self._calc_build_dir(build_type=build_type)

        # Make the target directory
        if not os.path.exists(build_dir):
            os.makedirs(build_dir)

        architecture = self.target.split("-", 1)[1].rsplit("-", 1)[0].strip()

        gradle_args = [
            "bundle%s" % (
                "Debug" if build_type == BuildType.DEBUG else "Release"
            ),
            "--build-cache",
            "--parallel",
            "--gradle-user-home",
            _project_path(".gradle/")
        ]
        if flavour:
            print("Android builds currently don't support flavors")

        if architecture == "all":
            architecture = "x86_64;armeabi-v7a;arm64-v8a;"

        print(f"Building architecture: {architecture} to {build_dir}")

        gradle_wrapper = _project_path(f"gradle/{self.gradle_binary}")

        gradle_cmd = [
            f"GRADLE_OPTS=-Dorg.gradle.project.buildDir={build_dir}",
            f"ABI_FILTERS='{architecture}'",
            gradle_wrapper
        ] + gradle_args

        ret = self._run_command(
            gradle_cmd,
            cwd=self._calc_gradle_dir(),
            check_output=False
        )

        if ret:
            sys.exit(ret)

    def package(self, flavour=""):
        """
            Android apps have to be packaged as APK files to run, so package and build are the same
            (except package prefers a release build)
        """
        self.target = "android-all-clang"
        self.build(rebuild=True, build_type=BuildType.RELEASE, flavour=flavour)

    def _check_prerequisites(self):
        """
            To run Android builds we need:

            - avdmanager - To create the AVD
            - emulator - to start the AVD and run the APK
        """

        if not shutil.which("avdmanager"):
            print("avdmanager is required to be on the PATH to run Android builds")
            exit(1)

        if not shutil.which("emulator"):
            print("'emulator' is required to be on the PATH to run Android builds")
            exit(1)

    def _create_avd_if_necessary(self):
        avd_name = "Simulant-28"  # For now we target at least Android-28
        platform_name = "system-images;android-28;google_apis;x86_64"

        output = ""
        try:
            output = subprocess.check_output(
                ["avdmanager", "list", "avd"]
            ).decode("utf-8", "ignore")
        except subprocess.CalledProcessError:
            print("Error checking AVD status")
            exit(1)

        if avd_name not in output:
            try:
                output = subprocess.check_output(
                    ["sdkmanager", "--list_installed"]
                ).decode("utf-8", "ignore")
            except subprocess.CalledProcessError:
                print("Error checking system image status")
                exit(1)

            if platform_name not in output:
                print("Installing required system image...")
                subprocess.check_call([
                    "sdkmanager", "--install", platform_name
                ])

        print("Creating AVD: %s..." % (avd_name))
        subprocess.check_call([
            f'echo no | avdmanager create avd -n {avd_name} -k "{platform_name}" -f'
        ], shell=True)

    def run(self, rebuild=False, build_type=BuildType.DEBUG, flavour=""):
        self._check_prerequisites()
        self._create_avd_if_necessary()

        print("\nWaiting for an Android emulator / device. Try running 'emulator -avd Simulant-28'")
        subprocess.check_call(["adb", "wait-for-device"])

        print("Detecting architecture...", end=None)
        architecture = subprocess.check_output(["adb", "shell", "getprop", "ro.product.cpu.abi"])
        architecture = architecture.decode("ascii").strip()
        print(architecture)

        self.target = f"android-{architecture}-clang"

        if rebuild:
            self.build(
                build_type=build_type,
                rebuild=rebuild,
                flavour=flavour
            )

        build_dir = self._calc_build_dir(build_type=build_type)

        deadline = datetime.now() + timedelta(seconds=120)
        while datetime.now() < deadline:
            output = subprocess.check_output(["adb", "shell", "getprop", "dev.bootcomplete"])
            if output.decode("ascii").strip() == "1":
                break
        else:
            print("Timeout waiting for Android device")
            exit(1)

        build_type_s = build_type_str(build_type)
        aab_path = f"{build_dir}/outputs/bundle/{build_type_s}/"
        aabs = [x for x in os.listdir(aab_path) if x.endswith(".aab")]

        aab_path = f"{aab_path}{aabs[0]}"
        apk_temp = f"{build_dir}/temp.apks"

        if os.path.exists(apk_temp):
            os.remove(apk_temp)

        print("Unpacking AAB: %s..." % (aab_path,))
        subprocess.check_call([
            "bundletool", "build-apks",
            "--bundle", aab_path, "--output", apk_temp
        ])

        print("Installing apks...")
        subprocess.check_call([
            "bundletool", "install-apks",
            "--apks", apk_temp
        ])


