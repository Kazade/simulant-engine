_DOWNLOAD_ROOT = "https://storage.googleapis.com/staging.simulant-engine.appspot.com"

PLACEHOLDER = "__project_name__"


class BuildType:
    DEBUG = 0
    RELEASE = 1
    RELDEBUG = 2


def build_type_str(build_type):
    if build_type == BuildType.DEBUG:
        return "debug"
    elif build_type == BuildType.RELEASE:
        return "release"
    elif build_type == BuildType.RELDEBUG:
        return "reldebug"
    else:
        return "unknown"


class UnsupportedPlatformError(ValueError):
    def __init__(self, platform):
        super(UnsupportedPlatformError, self).__init__(
            f"Your development platform ({platform}) is currently unsupported"
        )


def _make_executable(path):
    mode = os.stat(path).st_mode
    mode |= (mode & 0o444) >> 2    # copy R bits to X
    os.chmod(path, mode)


def _project_path(file_path):
    global _PROJECT_ROOT

    if not _PROJECT_ROOT:
        _PROJECT_ROOT = _find_project_root()

    return os.path.join(_PROJECT_ROOT, file_path)


def _rename_files_and_directories(search, replacement, directory):
    " Recursively replaces 'search' in folder and filenames with 'replacement' "
    for root, subdirs, files in os.walk(directory):
        for subdir in subdirs:
            if PLACEHOLDER in subdir:
                path = join(root, subdir)
                dest = join(root, subdir.replace(PLACEHOLDER, replacement))
                shutil.move(path, dest)

        for file in files:
            if PLACEHOLDER in file:
                path = join(root, file)
                dest = join(root, file.replace(PLACEHOLDER, replacement))
                shutil.move(path, dest)


def _search_replace(search, replacement, directory, extensions=[".cpp", ".h", ".md", ".json", ".txt"]):
    "Recursively search replace text in files that match the extensions"
    for root, subdirs, files in os.walk(directory):
        for file in files:
            if splitext(file)[-1] in extensions:
                path = join(root, file)

                with open(path, "r") as f:
                    s = f.read()

                s = s.replace(search, replacement)

                with open(path, "w") as f:
                    f.write(s)


def _find_project_root():
    SIMULANT_CONFIG = "simulant.json"

    path = os.path.abspath(SIMULANT_CONFIG)
    while not os.path.exists(path):
        new_path = os.path.dirname(path)
        if new_path == path:
            print("Unable to find {0}. Are you in the right directory?".format(
                SIMULANT_CONFIG
            ))

        path = new_path

    return os.path.dirname(path)


def _find_shipped_path(path):
    this_dir = os.path.dirname(__file__)

    final = os.path.join(this_dir, path)
    if os.path.exists(final):
        return os.path.abspath(final)

    # pip installs normally install this file to
    # PREFIX/bin/simulant. So the parent of the parent
    # directory should be the prefix
    guessed_prefix = os.path.dirname(this_dir)

    for prefix in (site.PREFIXES + [guessed_prefix]):
        final = os.path.join(prefix, "share/simulant-tools", path)
        if os.path.exists(final):
            return final

    raise ValueError("Unable to find: %s" % path)


def _download_zip_and_extract(zip_file, target_dir):
    r = requests.get(zip_file, stream=True)
    path = os.path.join(target_dir, zip_file.rsplit("/")[-1])

    with open(path, 'wb') as f:
        total_length = int(r.headers.get('content-length'))
        for chunk in progress.bar(
            r.iter_content(chunk_size=1024),
            expected_size=(total_length/1024) + 1
        ):
            if chunk:
                f.write(chunk)
                f.flush()

    zip_ref = zipfile.ZipFile(path, 'r')
    zip_ref.extractall(target_dir)
    zip_ref.close()

    os.remove(path)


def _download_docker_image(image):

    client = docker.from_env()

    try:
        print(("Checking for Docker image %s" % image).ljust(_STR_LENGTH), end='')
        client.images.get(image)
        print("[ OK ]")
    except docker.errors.ImageNotFound:
        print("[ NOT FOUND ]")
        print(("Downloading Docker image %s" % image).ljust(_STR_LENGTH), end='')
        client.images.pull(image)
        print("[ OK ]")
    except requests.exceptions.ConnectionError:
        print("[ FAILED ]")
        sys.exit(1)


def _check_docker_running():
    try:
        print("Checking Docker is running".ljust(_STR_LENGTH), end='')
        client = docker.from_env()
        client.containers.list()
        print("[ OK ]")
    except requests.exceptions.ConnectionError:
        print("[ FAILED ]")

        logging.error(
            "Either Docker is not running or you do not have the required permissions to run Docker commands. \n\n"
            "Try adding your user to the `docker` group (e.g. `sudo usermod -aG docker $USER`) and then restarting your session."
        )

        sys.exit(1)


def _start_docker_container(image, working_dir, volumes=None):
    volumes = volumes or {}

    client = docker.from_env()

    toolchains_folder = _find_shipped_path("toolchains")

    container = client.containers.run(
        image,
        "/bin/bash --login",
        detach=True,
        volumes={
            _find_project_root(): {
                "bind": _find_project_root(),
                "mode": "Z"
            },
            toolchains_folder: {
                "bind": toolchains_folder,
                "mode": "Z"
            },
            **volumes
        },
        tty=True,
        stdin_open=True,
        user=os.getuid()
    )

    return container


class Platform(object):
    required_docker_image = None
    required_toolchain_file = None
    requires_package_before_run = False
    cmake_binary = "cmake"
    executable_ext = ""

    def __init__(self, target, is_native, cmake_args):
        self.target = target
        self.is_native = is_native
        self.container = None
        self.cmake_args = cmake_args
        self.platform_name = self.__class__.__name__.lower()

    def _run_command(self, cmd, cwd, use_docker_image=True, check_output=True):
        if use_docker_image and self.required_docker_image:
            assert(self.container)

            api_client = self.container.client.api
            exec_handle = api_client.exec_create(
                self.container.name,
                '/bin/bash -c "source /etc/bash.bashrc; cd %s; %s"' % (cwd, " ".join(cmd))
            )

            stream = api_client.exec_start(exec_handle, stream=True)

            output = ""
            for line in stream:
                print(line.decode("utf-8"), end="")
                output += line.decode("utf-8")

            exit_code = api_client.exec_inspect(
                exec_handle['Id']
            ).get('ExitCode')

            if exit_code:
                if check_output:
                    raise IOError(output)
                else:
                    return exit_code
            else:
                if check_output:
                    return output
                else:
                    return exit_code

        else:
            if check_output:
                output = subprocess.check_output(cmd, cwd=cwd)
                return output.decode("utf-8")
            else:
                return subprocess.call(
                    cmd, cwd=cwd
                )

    def _generate_cmake_args(self, build_type=BuildType.DEBUG):
        libraries = _project_path("libraries")

        args = list(self.cmake_args) or []

        if build_type == BuildType.RELEASE:
            args.append("-DCMAKE_BUILD_TYPE=Release")
        elif build_type == BuildType.RELDEBUG:
            args.append("-DCMAKE_BUILD_TYPE=RelWithDebInfo")
        else:
            args.append("-DCMAKE_BUILD_TYPE=Debug")

        if self.required_toolchain_file:
            args.append(
                "-DCMAKE_TOOLCHAIN_FILE={0}".format(
                    _find_shipped_path(self.required_toolchain_file)
                )
            )

        args.append(
            "-DSIMULANT_INCLUDE_FOLDER={}".format(
                join(libraries, self.target, "include")
            )
        )

        if build_type in (BuildType.RELEASE, BuildType.RELDEBUG):
            args.append(
                "-DSIMULANT_LIBRARY_FOLDER={}".format(
                    join(libraries, self.target, "lib/release")
                )
            )
        else:
            # Use debug library in non-release builds
            args.append(
                "-DSIMULANT_LIBRARY_FOLDER={}".format(
                    join(libraries, self.target, "lib/debug")
                )
            )

        args.append("../../..")

        return args

    def _calc_build_dir(self, build_type=BuildType.DEBUG):
        build_name = {
            BuildType.DEBUG: "debug",
            BuildType.RELDEBUG: "reldebug",
            BuildType.RELEASE: "release"
        }

        return os.path.abspath(
            "build/{target}/{build_type}".format(
                target=self.target,
                build_type=build_name[build_type]
            )
        )

    def check_supported(self, this_platform):
        raise NotImplementedError()

    def _prepare(self, build_type, flavour, volumes=None):
        if self.required_docker_image:
            _check_docker_running()
            _download_docker_image(self.required_docker_image)
            self.container = _start_docker_container(
                self.required_docker_image,
                self._calc_build_dir(build_type=build_type),
                volumes
            )

        if flavour:
            # If we specified a flavour, we need to validate it exists in the JSON
            # file
            config = _project_path("simulant.json")
            with open(config) as f:
                data = json.loads(f.read())
                if flavour not in data.get("flavours", {}):
                    print(
                        f"You specified a flavour ({flavour}) but it's not in the flavours section of the simulant.json"
                    )
                    sys.exit(1)

    def build(self, build_type=BuildType.DEBUG, rebuild=False, flavour="", testing=False, additional_cmake_args=None, print_output=True):
        self._prepare(build_type=build_type, flavour=flavour)

        if rebuild:
            build_dir = self._calc_build_dir(build_type=build_type)
            if os.path.exists(build_dir):
                shutil.rmtree(build_dir)

        # Default behaviour is too use cmake to build
        build_dir = self._calc_build_dir(build_type=build_type)

        # Make the target directory
        if not os.path.exists(build_dir):
            os.makedirs(build_dir)

        cmake_args = self._generate_cmake_args(build_type=build_type)
        if testing:
            cmake_args.append("-DBUILD_TESTS=ON")

        cmake_args.extend(additional_cmake_args or [])

        # Add the flavour to the build args
        if flavour:
            cmake_args.append(f"-DSIMULANT_FLAVOUR={flavour}")

        cmake_cmd = [self.cmake_binary] + cmake_args

        print("Running: " + " ".join(cmake_cmd))
        ret = self._run_command(cmake_cmd, cwd=build_dir, check_output=False)
        if ret:
            sys.exit(ret)

        cpu_count = int(multiprocessing.cpu_count() * 1.5)

        ret = self._run_command(["make", "-j%s" % cpu_count], cwd=build_dir, check_output=False)
        if ret:
            sys.exit(ret)

    def run(self, rebuild=False, build_type=BuildType.DEBUG, flavour=""):
        if rebuild:
            self.build(build_type=build_type, rebuild=rebuild, flavour=flavour)

        build_dir = self._calc_build_dir(build_type=build_type)

        config = _project_path("simulant.json")
        libraries = _project_path(os.path.join("libraries", self.target, "lib"))

        with open(config) as f:
            data = json.loads(f.read())
            executable = data["executable"] + self.executable_ext

        env = dict(os.environ)
        env["LD_LIBRARY_PATH"] = libraries

        subprocess.call(
            [os.path.abspath(os.path.join(build_dir, executable))],
            cwd=".",
            env=env
        )

    def _generate_asset_list(self, config, flavour):
        if flavour:
            if flavour not in config.get("flavours", {}):
                print(f"Invalid flavour: {flavour}")
                sys.exit(1)

            patterns = config["flavours"][flavour].get("assets", [])
            patterns.extend(config["flavours"][flavour].get(
                f"assets[{self.platform_name}]", [])
            )

            if not patterns:
                patterns = ["**/*"]
        else:
            patterns = ["**/*"]

        assets_dir = _project_path("assets")

        results = []
        for pattern in patterns:
            new_paths = glob(pattern, root_dir=assets_dir, recursive=True)
            results.extend([join(assets_dir, p) for p in new_paths])
        return list(set(results))

    def package(self, flavour=""):
        raise NotImplementedError()

    def test(self, rebuild=True, build_type=BuildType.DEBUG):
        if rebuild:
            self.build(build_type=build_type, testing=True)

        build_dir = self._calc_build_dir(build_type=build_type)
        test_bin = join(build_dir, "tests")

        ret = self._run_command(
            [test_bin],
            cwd=_project_path("."),
            check_output=False,
            use_docker_image=False,
        )

        if ret:
            sys.exit(ret)


class Linux(Platform):
    required_docker_image = "kazade/linux-sdk"

    def _prepare(self, build_type, flavour):
        super(Linux, self)._prepare(build_type, flavour)

        if not self.is_native:
            raise UnsupportedPlatformError(
                "linux-x86-gcc"
            )

    def package(self, flavour):
        # Install flatpak sdk and runtime
        self._run_command(
            "flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo".split(),
            cwd="."
        )

        self._run_command(
            "flatpak install -y flathub org.freedesktop.Platform//22.08 org.freedesktop.Sdk//22.08".split(),
            cwd="."
        )

        package_dir = join(_project_path("packages"), self.target)
        package_tmp_dir = join(_project_path("packages"), self.target + "-tmp")
        package_build_dir = join(package_tmp_dir, "build")

        with open(_project_path("simulant.json")) as f:
            config = json.load(f)

        package_name = config["package"].lower()
        slug_name = config["name"].lower().replace(" ", "_").replace("_", "-")

        for folder in (package_dir, package_tmp_dir):
            if os.path.exists(folder):
                shutil.rmtree(folder)

            os.makedirs(folder)

        def _generate_appdata_xml():
            appdata_file = os.path.join(package_tmp_dir, package_name + ".appdata.xml")

            def set_text(node, text):
                t = doc.createTextNode(text)
                node.appendChild(t)
                return node

            doc = Document()
            root = doc.createElement("component")
            root.setAttribute("type", "desktop")
            root.appendChild(set_text(doc.createElement("id"), package_name))
            root.appendChild(set_text(doc.createElement("name"), config["name"]))

            desc = doc.createElement("description")
            p = doc.createElement("p")
            desc.appendChild(p)
            set_text(p, config["description"])
            root.appendChild(desc)

            # This is the license of the metadata file, NOT the license of the project
            root.appendChild(set_text(doc.createElement("metadata_license"), "FSFAP"))
            root.appendChild(set_text(doc.createElement("project_license"), config["license"]))

            launchable = doc.createElement("launchable")
            launchable.setAttribute("type", "desktop-id")
            set_text(launchable, config["package"] + ".desktop")
            root.appendChild(launchable)

            if config.get("website"):
                node = set_text(doc.createElement("url"), config["website"])
                node.setAttribute("type", "homepage")
                root.appendChild(node)

            doc.appendChild(root)

            if config.get("screenshots"):
                screenshots = doc.createElement("screenshots")
                root.appendChild(screenshots)
                for i, screenshot in enumerate(config.get("screenshots", [])):
                    shot = doc.createElement("screenshot")
                    if i == 0:
                        shot.setAttribute("type", "default")

                    image = set_text(doc.createElement("image"), screenshot)
                    shot.appendChild(image)
                    screenshots.appendChild(shot)

            content_rating = doc.createElement("content_rating")
            content_rating.setAttribute("type", "oars-1.1")
            root.appendChild(content_rating)

            content_attr1 = doc.createElement("content_attribute")
            content_attr1.setAttribute("id", "social-chat")
            set_text(content_attr1, "mild")

            content_attr2 = doc.createElement("content_attribute")
            content_attr2.setAttribute("id", "social-info")
            set_text(content_attr2, "mild")

            content_rating.appendChild(content_attr1)
            content_rating.appendChild(content_attr2)

            with open(appdata_file, "w") as f:
                doc.writexml(f, indent="  ", addindent="  ", newl="\n")

            return appdata_file

        def _generate_desktop_file():
            manifest_file = os.path.join(package_tmp_dir, package_name + ".desktop")
            with open(manifest_file, "w") as f:
                f.write("[Desktop Entry]\n")
                f.write(f"Name={config['name']}\n")
                f.write(f"Exec={config['executable']}\n")
                f.write("Type=Application\n")
                f.write(f"Icon={config['package']}\n")

            return manifest_file

        def _generate_manifest():
            manifest_file = os.path.join(package_tmp_dir, package_name + ".json")

            libraries_dir = join(
                _project_path("libraries"),
                self.target,
                "lib"
            )

            appdata_xml = _generate_appdata_xml()
            appdata_filename = os.path.split(appdata_xml)[1]

            data = {
                "app-id": package_name,
                "runtime": "org.freedesktop.Platform",
                "runtime-version": "22.08",
                "sdk": "org.freedesktop.Sdk",
                "command": config["executable"],
                "modules": [{
                    "name": "libraries",
                    "buildsystem": "simple",
                    "build-commands": [
                        "mkdir -p /app/lib && install libraries/*.so* /app/lib",
                    ],
                    "sources": [
                        {"type": "dir", "path": libraries_dir, "dest": "libraries"},
                    ],
                    "cleanup": [
                        "libraries",
                    ]
                }, {
                    "name": "appdata",
                    "buildsystem": "simple",
                    "build-commands": [
                        "mkdir -p /app/share/metainfo",
                        "mv {name} /app/share/metainfo/{name}".format(name=appdata_filename),
                    ],
                    "sources": [
                        {"type": "file", "path": appdata_xml}
                    ]
                }, {
                    "name": slug_name,
                    "buildsystem": "cmake",
                    "config-opts": [
                        "-DCMAKE_BUILD_TYPE=Release",
                        "-DSIMULANT_INCLUDE_FOLDER={}".format(
                            join("/run/build/%s/libraries/" % slug_name, self.target, "include")
                        ),
                        "-DSIMULANT_LIBRARY_FOLDER=/app/lib",
                        "-DSIMULANT_FLAVOUR={}".format(flavour),
                    ],
                    "sources": [
                        {"type": "dir", "path": _project_path("assets"), "dest": "assets"},
                        {"type": "dir", "path": _project_path("tools"), "dest": "tools"},
                        {"type": "dir", "path": _project_path("libraries"), "dest": "libraries"},
                        {"type": "dir", "path": _project_path("sources"), "dest": "sources"},
                        {"type": "file", "path": _project_path("CMakeLists.txt")}
                    ],
                    "cleanup": [
                        "assets", "tools", "libraries", "sources", "CMakeLists.txt"
                    ]
                }, {
                    "name": "assets",
                    "buildsystem": "simple",
                    "build-commands": [
                        "cp -r assets /app/bin/assets",
                    ],
                    "sources": [
                        {"type": "dir", "path": _project_path("assets"), "dest": "assets"},
                    ],
                    "cleanup": [
                        "assets"
                    ]
                }, {
                    "name": "desktop-file",
                    "buildsystem": "simple",
                    "build-commands": [
                        "cp %s /app/share/applications/%s.desktop" % (
                            _generate_desktop_file(), config['package']
                        )
                    ]
                }],
                "finish-args": [
                   "--socket=wayland",
                   "--share=network",
                   "--device=dri",
                   "--socket=pulseaudio"
                ],
            }

            with open(manifest_file, "w") as f:
                f.write(json.dumps(data))

            return manifest_file

        manifest_file = _generate_manifest()

        repo_dir = "%s/repo" % package_tmp_dir

        self._run_command(
            [
                "flatpak-builder", "-vv",
                "--delete-build-dirs",
                "--repo=%s" % repo_dir,
                "--force-clean", package_build_dir, manifest_file
            ],
            cwd=_project_path(".")
        )

        self._run_command(
            [
                "flatpak", "build-bundle", repo_dir,
                "%s/%s" % (package_dir, config['executable'] + ".flatpak"),
                package_name
            ],
            cwd=_project_path(".")
        )

        return 0


class Windows(Platform):
    required_docker_image = "kazade/windows-sdk"
    cmake_binary = "mingw64-cmake"
    executable_ext = ".exe"

    def build(self, build_type=BuildType.DEBUG, rebuild=False, print_output=True, flavour=""):
        super().build(
            build_type=build_type,
            rebuild=rebuild,
            print_output=print_output,
            flavour=flavour
        )

        # Copy DLLs to the build directory
        build_dir = self._calc_build_dir(build_type=build_type)

        libraries_dir = join(
            _project_path("libraries"),
            self.target,
            "lib"
        )

        if build_type in (BuildType.RELEASE, BuildType.RELDEBUG):
            libraries_dir = join(libraries_dir, "release")
        else:
            libraries_dir = join(libraries_dir, "debug")

        for f in os.listdir(libraries_dir):
            if f.endswith(".dll"):
                target = join(build_dir, f)
                source = join(libraries_dir, f)
                shutil.copy(source, target)

    def run(self, rebuild=False, build_type=BuildType.DEBUG):
        if rebuild:
            self.build(build_type=build_type)

        build_dir = self._calc_build_dir(build_type=build_type)

        config = _project_path("simulant.json")
        libraries = _project_path(os.path.join("libraries", self.target, "lib/release"))

        with open(config) as f:
            data = json.loads(f.read())
            executable = data["executable"] + self.executable_ext

        env = dict(os.environ)
        env["LD_LIBRARY_PATH"] = libraries

        def is_wsl2():
            return 'WSL' in platform.uname().release

        # On WSL2 we just launch the executable, on anything else
        # we use wine to do so
        if is_wsl2():
            subprocess.call(
                [os.path.abspath(os.path.join(build_dir, executable))],
                cwd=".",
                env=env
            )
        else:
            subprocess.call(
                ["wine", os.path.abspath(os.path.join(build_dir, executable))],
                cwd=".",
                env=env
            )

    def test(self, rebuild=True, build_type=BuildType.DEBUG):
        if rebuild:
            self.build(build_type=build_type)

        build_dir = self._calc_build_dir(build_type=build_type, testing=True)
        test_bin = join(build_dir, "tests")

        ret = self._run_command(
            ["wine", test_bin + self.executable_ext],
            cwd=_project_path("."),
            check_output=False,
            use_docker_image=False
        )

        if ret:
            sys.exit(ret)

    def package(self, flavour):
        # Perform a release rebuild
        self.build(build_type=BuildType.RELEASE, rebuild=True, flavour=flavour)

        build_dir = self._calc_build_dir(build_type=BuildType.RELEASE)
        package_dir = os.path.join(_project_path("packages"), self.target)
        package_tmp_dir = join(_project_path("packages"), self.target + "-tmp")

        for folder in (package_dir, package_tmp_dir):
            if os.path.exists(folder):
                shutil.rmtree(folder)

            os.makedirs(folder)

        config = _project_path("simulant.json")

        with open(config) as f:
            data = json.loads(f.read())
            executable = data["executable"]

        source_assets_dir = _project_path("assets")
        target_assets_dir = join(package_tmp_dir, "assets")
        os.makedirs(target_assets_dir, exist_ok=True)

        source_asset_list = self._generate_asset_list(data, flavour)
        for asset in source_asset_list:
            if not os.path.isfile(asset):
                continue

            relative = asset.replace(source_assets_dir, "").lstrip("/")
            final_path = join(target_assets_dir, relative)
            os.makedirs(dirname(final_path), exist_ok=True)
            shutil.copy(asset, final_path)

        exe_name = "%s.exe" % executable
        binary = join(build_dir, exe_name)
